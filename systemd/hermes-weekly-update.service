[Unit]
Description=Awesome Hermes Updates: verified update and recovery
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=6

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/hermes-weekly-update
Restart=on-failure
RestartSec=2min
RestartPreventExitStatus=64 66 73 78
Nice=10
IOSchedulingClass=idle
CPUQuota=600%
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=0
TasksMax=1024
TimeoutStartSec=4h
OOMPolicy=stop
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.hermes -%h/.cache %h/.local/state -%h/.npm -%h/.codex -%h/.claude
ReadWritePaths=%h/.config/systemd/user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
