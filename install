#!/usr/bin/env python3
"""Install one immutable package generation, then switch it into use."""
import argparse
import hashlib
import os
from pathlib import Path
import shutil
import runpy
import sys
import subprocess
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--stage', type=Path, help='build a test installation in this directory; do not use systemd')
    parser.add_argument('--no-systemd', action='store_true', help='install manual commands without using systemd')
    parser.add_argument('--repo', help='Hermes Agent Git checkout (default: HERMES_HOME/hermes-agent)')
    parser.add_argument('--hermes-home', help='Hermes data directory (default: HERMES_HOME or ~/.hermes)')
    parser.add_argument('--schedule', help='on-demand, or a systemd calendar such as daily; existing schedules are preserved')
    parser.add_argument('--skills', choices=('codex', 'claude', 'both', 'none'),
                        help='install the operator skill for these clients; default: preserve previous selection, otherwise none')
    args = parser.parse_args()
    if sys.platform != 'linux':
        parser.error('Awesome Hermes Updates currently supports Linux only; macOS support is not implemented')
    source = Path(__file__).resolve().parent
    home = args.stage.resolve() if args.stage else Path.home()
    base = home / '.local/share/awesome-hermes-updates'
    skill_selection = base / 'skill-clients'
    clients = args.skills or (skill_selection.read_text().strip() if skill_selection.exists() else 'none')
    if clients not in ('codex', 'claude', 'both', 'none'):
        parser.error(f'invalid saved skill selection in {skill_selection}; pass --skills to replace it')
    skill_target = base / 'current/skills/update-hermes-agent'
    skill_links = {client: home / directory / 'skills/update-hermes-agent'
                   for client, directory in (('codex', '.agents'), ('claude', '.claude'))}
    selected = set(skill_links) if clients == 'both' else ({clients} if clients != 'none' else set())
    helper = runpy.run_path(str(source / 'bin/hermes-update-config'))
    config = helper['config_path'](home)
    saved = helper['read_config'](config)
    proposed = dict(saved)
    use_systemd = not args.stage and not args.no_systemd
    installed_timer = home / '.config/systemd/user/hermes-weekly-update.timer'
    timer_dropin = home / '.config/systemd/user/hermes-weekly-update.timer.d/schedule.conf'
    # Import the legacy calendar before switching immutable releases. The timer's
    # enabled state is preserved by leaving systemctl enable/disable untouched.
    if installed_timer.exists() and not timer_dropin.exists() and 'HERMES_UPDATE_SCHEDULE' not in saved and not args.schedule:
        calendars = helper['timer_calendars'](home, use_systemd=use_systemd)
        if len(calendars) == 1:
            proposed['HERMES_UPDATE_SCHEDULE'] = calendars[0]
        elif len(calendars) > 1:
            parser.error('the existing timer has multiple calendar expressions; pass --schedule to choose its replacement')
    if args.repo:
        proposed['HERMES_UPDATE_REPO'] = args.repo
    if args.hermes_home:
        proposed['HERMES_UPDATE_HOME'] = args.hermes_home
    if args.schedule:
        helper['validate_calendar'](args.schedule)
        proposed['HERMES_UPDATE_SCHEDULE'] = args.schedule
    # Capture HERMES_HOME only for a real first installation, never from stage tests.
    if not config.exists() and not args.stage and os.environ.get('HERMES_HOME') and not args.hermes_home:
        proposed['HERMES_UPDATE_HOME'] = os.environ['HERMES_HOME']
    settings = helper['effective'](proposed, home=home, environ={})
    helper['validate_calendar'](settings['HERMES_UPDATE_SCHEDULE'])
    previous = helper['effective'](saved, home=home, environ={})
    use_systemd = not args.stage and not args.no_systemd
    fresh_timer = not (home / '.config/systemd/user/hermes-weekly-update.timer').exists()
    if not args.stage:
        for command in ('bash', 'git', 'python3'):
            if not shutil.which(command):
                parser.error(f'missing required command: {command}')
    if use_systemd:
        helper['check_user_manager']()
    with helper['settings_lock'](previous, reject_pending=bool(args.repo or args.hermes_home)):
        # Skill stores can contain user-edited copies. Only manage our own links.
        for client in selected:
            dest = skill_links[client]
            managed = dest.is_symlink() and dest.readlink() == skill_target
            if (dest.exists() or dest.is_symlink()) and not managed:
                parser.error(f'{dest} already exists and is not managed by this installer; move it aside or choose --skills none')
        helper['prepare_runtime_dirs'](home, settings)
        files = [source / 'README.md']
        for directory in ('bin', 'systemd', 'skills', 'docs', '.codex-plugin', '.claude-plugin'):
            files.extend(sorted(p for p in (source / directory).rglob('*') if p.is_file() and '__pycache__' not in p.parts and p.suffix != '.pyc'))
        digest = hashlib.sha256()
        for file in files:
            digest.update(str(file.relative_to(source)).encode() + b'\0' + file.read_bytes())
        releases = base / 'releases'
        releases.mkdir(parents=True, exist_ok=True)
        release = releases / digest.hexdigest()[:20]
        if not release.exists():
            staging = Path(tempfile.mkdtemp(prefix='.install-', dir=releases))
            try:
                for file in files:
                    target = staging / file.relative_to(source)
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(file, target)
                staging.rename(release)
            finally:
                if staging.exists():
                    shutil.rmtree(staging)
        def link(target, dest):
            dest.parent.mkdir(parents=True, exist_ok=True)
            if dest.exists() and not dest.is_symlink():
                backup = base / 'previous' / dest.relative_to(home)
                backup.parent.mkdir(parents=True, exist_ok=True)
                if not backup.exists():
                    shutil.copy2(dest, backup)
            temporary = dest.with_name(dest.name + f'.install-{os.getpid()}')
            temporary.symlink_to(target)
            temporary.replace(dest)
        link(release, base / 'current')
        # Some users share skill stores by symlinking the parent directory.
        selected_locations = {skill_links[client].parent.resolve() / skill_links[client].name
                              for client in selected}
        for client, dest in skill_links.items():
            if client in selected:
                link(skill_target, dest)
            elif (dest.parent.resolve() / dest.name not in selected_locations
                  and dest.is_symlink() and dest.readlink() == skill_target):
                dest.unlink()
        helper['atomic_write'](skill_selection, clients + '\n')
        for file in (release / 'bin').iterdir():
            link(base / 'current/bin' / file.name, home / '.local/bin' / file.name)
        if not args.no_systemd:
            for file in (release / 'systemd').iterdir():
                link(base / 'current/systemd' / file.name, home / '.config/systemd/user' / file.name)
        if not config.exists() or proposed != saved:
            helper['write_config'](config, proposed)
        if not args.no_systemd:
            # Preserve the pre-configuration weekly timer on upgrade unless the
            # user explicitly changes it. Its old calendar remains in a drop-in.
            timer_dropin = home / '.config/systemd/user/hermes-weekly-update.timer.d/schedule.conf'
            old_calendar = timer_dropin.read_text() if timer_dropin.exists() else None
            helper['write_units'](home, settings)
            if not fresh_timer and not args.schedule and old_calendar is not None:
                helper['atomic_write'](timer_dropin, old_calendar)
        (base / 'source').write_text(str(source) + '\n')
    if use_systemd:
        helper['systemctl']('daemon-reload')
        if args.schedule or fresh_timer:
            helper['apply_schedule'](settings)
        helper['systemctl']('enable', 'hermes-weekly-update-recovery.service')
    print(f'Installed Awesome Hermes Updates: {release.name}')
    print(f'Operator skill clients: {clients}')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(78)
