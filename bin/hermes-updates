#!/usr/bin/env python3
"""Configure and run updates for your Hermes Agent installation."""
import argparse
import json
import os
from pathlib import Path
import runpy
import subprocess
import sys

config = runpy.run_path(str(Path(__file__).resolve().with_name('hermes-update-config')))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('config', help='show effective settings as JSON (environment overrides included)')
    commands.add_parser('plan', help='show configured scope without fetching or changing Hermes')
    configure = commands.add_parser('configure', help='save installation paths and deployment scope')
    configure.add_argument('--repo')
    configure.add_argument('--hermes-home', dest='home')
    for component in config['COMPONENTS']:
        configure.add_argument('--' + component.lower(), choices=('auto', 'on', 'off'))
    configure.add_argument('--extras', help='comma-separated Python extras; empty means core dependencies')
    configure.add_argument('--profiles', help='auto, or comma-separated default/profile names')
    configure.add_argument('--max-repairs', type=int, help='0 (default) through 20; positive values opt into source repairs')
    configure.add_argument('--repair-agent', choices=('codex', 'claude'), help='source repair CLI (default: codex)')
    configure.add_argument('--ref', help='upstream Git ref (default: main)')
    configure.add_argument('--no-systemd', action='store_true', help='save settings without using a user service manager')
    schedule = commands.add_parser('schedule', help='set on-demand or a systemd calendar, e.g. "daily"')
    schedule.add_argument('calendar')
    run = commands.add_parser('run', help='run an update with systemd resource limits')
    run.add_argument('--check', action='store_true', help='check upstream without promoting an update')
    run.add_argument('--direct', action='store_true', help='run in this terminal without systemd resource limits')
    args = parser.parse_args()
    try:
        path = config['config_path']()
        saved = config['read_config'](path)
        settings = config['effective'](saved)
        if args.command == 'config':
            print(json.dumps(settings, indent=2, sort_keys=True))
        elif args.command == 'plan':
            print(f"Repository: {settings['HERMES_UPDATE_REPO']}")
            print(f"Hermes home: {settings['HERMES_UPDATE_HOME']}")
            print('Source: update the whole Git commit after candidate verification')
            for component in config['COMPONENTS']:
                print(f"{component.lower()}: {settings['HERMES_UPDATE_' + component]}")
            print(f"Python extras: {settings['HERMES_UPDATE_EXTRAS'] or '(core only)'}")
            print(f"Profiles: {settings['HERMES_UPDATE_PROFILES']}")
            print(f"Repair attempts: {settings['HERMES_UPDATE_MAX_REPAIRS']}")
            print(f"Repair agent: {settings['HERMES_UPDATE_REPAIR_AGENT']}")
            print(f"Schedule: {settings['HERMES_UPDATE_SCHEDULE']}")
            print('Installed component selection:', flush=True)
            controller = Path(__file__).resolve().with_name('hermes-weekly-update')
            return subprocess.run([str(controller), '--plan'], env=config['runtime_environment'](settings)).returncode
        elif args.command in ('configure', 'schedule'):
            proposed = dict(saved)
            if args.command == 'schedule':
                config['validate_calendar'](args.calendar)
                proposed['HERMES_UPDATE_SCHEDULE'] = args.calendar
            else:
                for name, value in vars(args).items():
                    if name not in ('command', 'no_systemd') and value is not None:
                        proposed['HERMES_UPDATE_' + name.upper()] = str(value)
            # Persist explicit arguments, never ambient per-run overrides.
            old = config['effective'](saved, environ={})
            updated = config['effective'](proposed, environ={})
            config['validate_calendar'](updated['HERMES_UPDATE_SCHEDULE'])
            use_systemd = args.command == 'schedule' or not args.no_systemd
            if use_systemd:
                config['check_user_manager']()
            with config['settings_lock'](old):
                config['write_config'](path, proposed)
                if use_systemd:
                    config['write_units'](Path.home(), updated)
                    if args.command == 'schedule':
                        config['apply_schedule'](updated)
                    else:
                        config['systemctl']('daemon-reload')
            print('Saved ' + str(path))
        elif args.command == 'run':
            controller = Path(__file__).resolve().with_name('hermes-weekly-update')
            arguments = [str(controller)] + (['--check'] if args.check else [])
            if args.direct:
                os.execve(controller, arguments, config['runtime_environment'](settings))
            config['prepare_runtime_dirs'](Path.home(), settings)
            command = ['systemd-run', '--user', '--wait', '--collect', '--pipe',
                       f'--unit=hermes-updates-manual-{os.getpid()}',
                       '--property=Type=exec', '--property=CPUQuota=600%',
                       '--property=MemoryHigh=6G', '--property=MemoryMax=8G',
                       '--property=MemorySwapMax=0', '--property=TasksMax=1024',
                       '--property=RuntimeMaxSec=4h', '--property=UMask=0077',
                       '--property=NoNewPrivileges=true', '--property=PrivateTmp=true',
                       '--property=ProtectSystem=strict', '--property=ProtectHome=read-only']
            writable = [settings[key] for key in ('HERMES_UPDATE_HOME', 'HERMES_UPDATE_REPO', 'HERMES_UPDATE_STATE_DIR')]
            writable.extend(str(Path.home() / name) for name in ('.cache', '.local/state', '.npm', '.codex', '.claude', '.config/systemd/user'))
            command.append('--property=ReadWritePaths=' + ' '.join(config['unit_path']('-' + path) for path in writable))
            for key, value in {**settings, 'HERMES_UPDATE_CONFIG_LOADED': '1', 'PATH': config['runtime_environment'](settings)['PATH']}.items():
                command.append(f'--setenv={key}={value}')
            return subprocess.run([*command, '--', *arguments]).returncode
        return 0
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        return 78


if __name__ == '__main__':
    sys.exit(main())
